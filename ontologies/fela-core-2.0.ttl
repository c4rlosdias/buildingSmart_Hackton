@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix fela: <https://example.org/fela#> .

<https://example.org/fela>
    a owl:Ontology ;
    rdfs:label "FELA Core Ontology"@en ;
    dct:title "FELA Core Ontology"@en ;
    dct:description "Core ontology for fire extinguisher standards including property sets and rule metamodel."@en ;
    owl:versionInfo "4.0.0" .

#################################################################
# DOMAIN CLASSES
#################################################################

fela:FireExtinguisher a owl:Class .
fela:BuildingStorey a owl:Class .

fela:RiskClass a owl:Class .
fela:FireClass a owl:Class .
fela:ExtinguishingAgent a owl:Class .

#################################################################
# PROPERTY SET MODEL
#################################################################

fela:PropertySet a owl:Class .

fela:appliesTo a owl:ObjectProperty ;
    rdfs:domain fela:PropertySet ;
    rdfs:range owl:Class .

fela:belongsToPset a owl:ObjectProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range fela:PropertySet .

#################################################################
# PROPERTY SET DEFINITIONS
#################################################################

fela:Pset_FireExtinguisher_FELA a owl:Class ;
    rdfs:subClassOf fela:PropertySet ;
    fela:appliesTo fela:FireExtinguisher .

fela:Pset_FireExtinguisher_Mechanical a owl:Class ;
    rdfs:subClassOf fela:PropertySet ;
    fela:appliesTo fela:FireExtinguisher .

fela:Pset_FireExtinguisher_Installation a owl:Class ;
    rdfs:subClassOf fela:PropertySet ;
    fela:appliesTo fela:FireExtinguisher .

fela:Pset_FireExtinguisher_Spatial a owl:Class ;
    rdfs:subClassOf fela:PropertySet ;
    fela:appliesTo fela:FireExtinguisher .

fela:Pset_FireSafety_Context a owl:Class ;
    rdfs:subClassOf fela:PropertySet ;
    fela:appliesTo fela:FireExtinguisher .

fela:Pset_BuildingStorey_FireSafety a owl:Class ;
    rdfs:subClassOf fela:PropertySet ;
    fela:appliesTo fela:BuildingStorey .

#################################################################
# ENUMERATIONS
#################################################################

fela:LightRisk a fela:RiskClass .
fela:ModerateRisk a fela:RiskClass .
fela:HighRisk a fela:RiskClass .

fela:ClassA a fela:FireClass .
fela:ClassB a fela:FireClass .
fela:ClassC a fela:FireClass .

fela:Water a fela:ExtinguishingAgent .
fela:CO2 a fela:ExtinguishingAgent .
fela:Foam a fela:ExtinguishingAgent .
fela:DryChemicalABC a fela:ExtinguishingAgent .
fela:DryChemicalBC a fela:ExtinguishingAgent .

#################################################################
# PROPERTIES (ALIGNED WITH IFC)
#################################################################

fela:BurstPressure a owl:DatatypeProperty ;
    rdfs:label "Burst Pressure"@en ;
    rdfs:comment "Pressão de Ruptura"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_Mechanical .

fela:NominalChargingPressure a owl:DatatypeProperty ;
    rdfs:label "Nominal Charging Pressure"@en ;
    rdfs:comment "Pressão Nominal de Carga"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_Mechanical .

fela:PressurisationMode a owl:DatatypeProperty ;
    rdfs:label "Pressurisation Mode"@en ;
    rdfs:comment "Tipo de Pressurização"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_Mechanical .

fela:JointType a owl:DatatypeProperty ;
    rdfs:label "Joint Type"@en ;
    rdfs:comment "Tipo de União"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_Mechanical .

fela:ExtinguisherType a owl:DatatypeProperty ;
    rdfs:label "Extinguisher Type"@en ;
    rdfs:comment "Tipo de Extintor"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_FELA .

fela:ExtinguishingCapacity a owl:DatatypeProperty ;
    rdfs:label "Extinguishing Capacity"@en ;
    rdfs:comment "Capacidade Extintora"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_FELA .

fela:IsCertified a owl:DatatypeProperty ;
    rdfs:label "Is Certified"@en ;
    rdfs:comment "Certificado"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_FELA .

fela:AgentMass a owl:DatatypeProperty ;
    rdfs:label "Agent Mass"@en ;
    rdfs:comment "Massa do Agente Extintor"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_FELA .

fela:HydrostaticTestDate a owl:DatatypeProperty ;
    rdfs:label "Hydrostatic Test Date"@en ;
    rdfs:comment "Data do Ensaio Hidrostático"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_FELA .

fela:RiskClassProperty a owl:ObjectProperty ;
    rdfs:range fela:RiskClass ;
    fela:belongsToPset fela:Pset_FireExtinguisher_Installation .

fela:MountingHeight a owl:DatatypeProperty ;
    rdfs:label "Mounting Height"@en ;
    rdfs:comment "Altura de Instalação"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_Installation .

fela:MaxTravelDistance a owl:DatatypeProperty ;
    rdfs:label "Maximum Travel Distance"@en ;
    rdfs:comment "Distância Máxima de Percurso"@pt ;
    fela:belongsToPset fela:Pset_FireExtinguisher_Spatial .

fela:FloorArea a owl:DatatypeProperty ;
    rdfs:label "Floor Area"@en ;
    rdfs:comment "Área do Pavimento"@pt ;
    fela:belongsToPset fela:Pset_BuildingStorey_FireSafety .

fela:LiquidSurfaceArea a owl:DatatypeProperty ;
    rdfs:label "Liquid Surface Area"@en ;
    rdfs:comment "Área de Superfície de Líquido Inflamável"@pt ;
    fela:belongsToPset fela:Pset_BuildingStorey_FireSafety .

fela:FireClassProperty a owl:ObjectProperty ;
    rdfs:range fela:FireClass ;
    fela:belongsToPset fela:Pset_FireSafety_Context .

#################################################################
# RULE METAMODEL (EXISTING)
#################################################################

fela:NormativeRule a owl:Class .

fela:appliesToClass a owl:ObjectProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range owl:Class .

fela:hasFormula a owl:DatatypeProperty .
fela:hasRequirementText a owl:DatatypeProperty .
fela:isExpressibleInIDS a owl:DatatypeProperty .
fela:isExpressibleInIDCS a owl:DatatypeProperty .

#################################################################
# RULE DSL EXTENSION (NEW - WITHOUT REMOVING EXISTING CONTENT)
#################################################################

fela:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "Condição de aplicabilidade ou filtro lógico de uma regra."@pt .

fela:Constraint a owl:Class ;
    rdfs:label "Constraint"@en ;
    rdfs:comment "Restrição normativa atômica que deve ser satisfeita."@pt .

fela:Expression a owl:Class ;
    rdfs:label "Expression"@en ;
    rdfs:comment "Expressão estruturada utilizada em condições e restrições."@pt .

fela:PropertyReference a owl:Class ;
    rdfs:label "Property Reference"@en ;
    rdfs:comment "Referência explícita a uma propriedade do vocabulário FELA."@pt .

fela:LiteralValue a owl:Class ;
    rdfs:label "Literal Value"@en ;
    rdfs:comment "Valor literal tipado utilizado em expressões."@pt .

#################################################################
# RELATIONSHIP BETWEEN RULES, CONDITIONS AND CONSTRAINTS
#################################################################

fela:hasCondition a owl:ObjectProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range fela:Condition ;
    rdfs:label "has condition"@en ;
    rdfs:comment "Relaciona uma regra às suas condições explícitas."@pt .

fela:hasConstraint a owl:ObjectProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range fela:Constraint ;
    rdfs:label "has constraint"@en ;
    rdfs:comment "Relaciona uma regra às suas restrições explícitas."@pt .

fela:dependsOnProperty a owl:ObjectProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range rdf:Property ;
    rdfs:label "depends on property"@en ;
    rdfs:comment "Indica as propriedades necessárias para avaliar a regra."@pt .

#################################################################
# OPERAND / REFERENCE MODEL
#################################################################

fela:refersToProperty a owl:ObjectProperty ;
    rdfs:domain fela:PropertyReference ;
    rdfs:range rdf:Property ;
    rdfs:label "refers to property"@en ;
    rdfs:comment "Liga uma referência estruturada à propriedade FELA correspondente."@pt .

fela:hasValue a owl:DatatypeProperty ;
    rdfs:domain fela:LiteralValue ;
    rdfs:range xsd:string ;
    rdfs:label "has value"@en ;
    rdfs:comment "Representa o conteúdo lexical de um valor literal."@pt .

fela:hasDatatypeIRI a owl:DatatypeProperty ;
    rdfs:domain fela:LiteralValue ;
    rdfs:range xsd:anyURI ;
    rdfs:label "has datatype IRI"@en ;
    rdfs:comment "Representa o datatype esperado do literal."@pt .

fela:hasUnit a owl:DatatypeProperty ;
    rdfs:domain fela:LiteralValue ;
    rdfs:range xsd:string ;
    rdfs:label "has unit"@en ;
    rdfs:comment "Representa a unidade associada ao valor literal."@pt .

#################################################################
# CONDITION TYPES
#################################################################

fela:AtomicCondition a owl:Class ;
    rdfs:subClassOf fela:Condition ;
    rdfs:label "Atomic Condition"@en ;
    rdfs:comment "Condição elementar, sem agregação ou simplificação."@pt .

fela:CompositeCondition a owl:Class ;
    rdfs:subClassOf fela:Condition ;
    rdfs:label "Composite Condition"@en ;
    rdfs:comment "Condição composta por outras condições."@pt .

fela:EqualsCondition a owl:Class ;
    rdfs:subClassOf fela:AtomicCondition ;
    rdfs:label "Equals Condition"@en ;
    rdfs:comment "Condição de igualdade entre uma propriedade e um valor."@pt .

fela:GreaterThanCondition a owl:Class ;
    rdfs:subClassOf fela:AtomicCondition ;
    rdfs:label "Greater Than Condition"@en ;
    rdfs:comment "Condição de comparação estritamente maior."@pt .

fela:GreaterOrEqualCondition a owl:Class ;
    rdfs:subClassOf fela:AtomicCondition ;
    rdfs:label "Greater Or Equal Condition"@en ;
    rdfs:comment "Condição de comparação maior ou igual."@pt .

fela:LessThanCondition a owl:Class ;
    rdfs:subClassOf fela:AtomicCondition ;
    rdfs:label "Less Than Condition"@en ;
    rdfs:comment "Condição de comparação estritamente menor."@pt .

fela:LessOrEqualCondition a owl:Class ;
    rdfs:subClassOf fela:AtomicCondition ;
    rdfs:label "Less Or Equal Condition"@en ;
    rdfs:comment "Condição de comparação menor ou igual."@pt .

fela:AndCondition a owl:Class ;
    rdfs:subClassOf fela:CompositeCondition ;
    rdfs:label "And Condition"@en ;
    rdfs:comment "Conjunção lógica de condições."@pt .

fela:OrCondition a owl:Class ;
    rdfs:subClassOf fela:CompositeCondition ;
    rdfs:label "Or Condition"@en ;
    rdfs:comment "Disjunção lógica de condições."@pt .

fela:NotCondition a owl:Class ;
    rdfs:subClassOf fela:CompositeCondition ;
    rdfs:label "Not Condition"@en ;
    rdfs:comment "Negação lógica de uma condição."@pt .

fela:conditionLeftOperand a owl:ObjectProperty ;
    rdfs:domain fela:AtomicCondition ;
    rdfs:range owl:Thing ;
    rdfs:label "condition left operand"@en ;
    rdfs:comment "Operando esquerdo de uma condição atômica."@pt .

fela:conditionRightOperand a owl:ObjectProperty ;
    rdfs:domain fela:AtomicCondition ;
    rdfs:range owl:Thing ;
    rdfs:label "condition right operand"@en ;
    rdfs:comment "Operando direito de uma condição atômica."@pt .

fela:hasSubCondition a owl:ObjectProperty ;
    rdfs:domain fela:CompositeCondition ;
    rdfs:range fela:Condition ;
    rdfs:label "has sub condition"@en ;
    rdfs:comment "Relaciona condições compostas às suas subcondições."@pt .

#################################################################
# CONSTRAINT TYPES
#################################################################

fela:AtomicConstraint a owl:Class ;
    rdfs:subClassOf fela:Constraint ;
    rdfs:label "Atomic Constraint"@en ;
    rdfs:comment "Restrição elementar, sem agregação implícita."@pt .

fela:CompositeConstraint a owl:Class ;
    rdfs:subClassOf fela:Constraint ;
    rdfs:label "Composite Constraint"@en ;
    rdfs:comment "Restrição composta por outras restrições."@pt .

fela:ComparisonConstraint a owl:Class ;
    rdfs:subClassOf fela:AtomicConstraint ;
    rdfs:label "Comparison Constraint"@en ;
    rdfs:comment "Restrição baseada em comparação explícita entre operandos."@pt .

fela:MembershipConstraint a owl:Class ;
    rdfs:subClassOf fela:AtomicConstraint ;
    rdfs:label "Membership Constraint"@en ;
    rdfs:comment "Restrição de pertencimento a um conjunto de valores permitidos."@pt .

fela:AndConstraint a owl:Class ;
    rdfs:subClassOf fela:CompositeConstraint ;
    rdfs:label "And Constraint"@en ;
    rdfs:comment "Conjunção de restrições."@pt .

fela:OrConstraint a owl:Class ;
    rdfs:subClassOf fela:CompositeConstraint ;
    rdfs:label "Or Constraint"@en ;
    rdfs:comment "Disjunção de restrições."@pt .

fela:NotConstraint a owl:Class ;
    rdfs:subClassOf fela:CompositeConstraint ;
    rdfs:label "Not Constraint"@en ;
    rdfs:comment "Negação de restrição."@pt .

fela:constraintLeftOperand a owl:ObjectProperty ;
    rdfs:domain fela:AtomicConstraint ;
    rdfs:range owl:Thing ;
    rdfs:label "constraint left operand"@en ;
    rdfs:comment "Operando esquerdo de uma restrição atômica."@pt .

fela:constraintRightOperand a owl:ObjectProperty ;
    rdfs:domain fela:AtomicConstraint ;
    rdfs:range owl:Thing ;
    rdfs:label "constraint right operand"@en ;
    rdfs:comment "Operando direito de uma restrição atômica."@pt .

fela:hasSubConstraint a owl:ObjectProperty ;
    rdfs:domain fela:CompositeConstraint ;
    rdfs:range fela:Constraint ;
    rdfs:label "has sub constraint"@en ;
    rdfs:comment "Relaciona restrições compostas às suas subrestrições."@pt .

#################################################################
# OPERATOR VOCABULARY
#################################################################

fela:Operator a owl:Class ;
    rdfs:label "Operator"@en ;
    rdfs:comment "Vocabulário controlado de operadores usados em condições e restrições."@pt .

fela:EqualsOperator a fela:Operator .
fela:NotEqualsOperator a fela:Operator .
fela:GreaterThanOperator a fela:Operator .
fela:GreaterOrEqualOperator a fela:Operator .
fela:LessThanOperator a fela:Operator .
fela:LessOrEqualOperator a fela:Operator .
fela:InOperator a fela:Operator .
fela:NotInOperator a fela:Operator .

fela:usesOperator a owl:ObjectProperty ;
    rdfs:label "uses operator"@en ;
    rdfs:comment "Relaciona uma condição ou restrição ao operador formal utilizado."@pt .

#################################################################
# EXPRESSION TYPES
#################################################################

fela:ArithmeticExpression a owl:Class ;
    rdfs:subClassOf fela:Expression ;
    rdfs:label "Arithmetic Expression"@en ;
    rdfs:comment "Expressão aritmética formal."@pt .

fela:MultiplyExpression a owl:Class ;
    rdfs:subClassOf fela:ArithmeticExpression ;
    rdfs:label "Multiply Expression"@en ;
    rdfs:comment "Expressão de multiplicação."@pt .

fela:DivideExpression a owl:Class ;
    rdfs:subClassOf fela:ArithmeticExpression ;
    rdfs:label "Divide Expression"@en ;
    rdfs:comment "Expressão de divisão."@pt .

fela:AddExpression a owl:Class ;
    rdfs:subClassOf fela:ArithmeticExpression ;
    rdfs:label "Add Expression"@en ;
    rdfs:comment "Expressão de adição."@pt .

fela:SubtractExpression a owl:Class ;
    rdfs:subClassOf fela:ArithmeticExpression ;
    rdfs:label "Subtract Expression"@en ;
    rdfs:comment "Expressão de subtração."@pt .

fela:MaxExpression a owl:Class ;
    rdfs:subClassOf fela:ArithmeticExpression ;
    rdfs:label "Max Expression"@en ;
    rdfs:comment "Expressão que retorna o máximo entre operandos."@pt .

fela:MinExpression a owl:Class ;
    rdfs:subClassOf fela:ArithmeticExpression ;
    rdfs:label "Min Expression"@en ;
    rdfs:comment "Expressão que retorna o mínimo entre operandos."@pt .

fela:CeilExpression a owl:Class ;
    rdfs:subClassOf fela:ArithmeticExpression ;
    rdfs:label "Ceil Expression"@en ;
    rdfs:comment "Expressão de arredondamento para cima."@pt .

fela:DateDifferenceExpression a owl:Class ;
    rdfs:subClassOf fela:Expression ;
    rdfs:label "Date Difference Expression"@en ;
    rdfs:comment "Expressão de diferença entre datas."@pt .

fela:CurrentDateExpression a owl:Class ;
    rdfs:subClassOf fela:Expression ;
    rdfs:label "Current Date Expression"@en ;
    rdfs:comment "Expressão que representa a data corrente no momento da avaliação."@pt .

fela:hasOperand a owl:ObjectProperty ;
    rdfs:domain fela:Expression ;
    rdfs:range owl:Thing ;
    rdfs:label "has operand"@en ;
    rdfs:comment "Relaciona uma expressão aos seus operandos."@pt .

#################################################################
# NORMALISATION / UNIFORMITY CONTROL
#################################################################

fela:mustBeAtomic a owl:DatatypeProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range xsd:boolean ;
    rdfs:label "must be atomic"@en ;
    rdfs:comment "Indica que a regra deve ser decomposta em condições e restrições atômicas, sem simplificação algébrica agregada."@pt .

fela:mustUseStructuredConditions a owl:DatatypeProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range xsd:boolean ;
    rdfs:label "must use structured conditions"@en ;
    rdfs:comment "Indica que a aplicabilidade da regra deve ser representada com objetos Condition e não apenas em texto."@pt .

fela:mustUseStructuredConstraints a owl:DatatypeProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range xsd:boolean ;
    rdfs:label "must use structured constraints"@en ;
    rdfs:comment "Indica que a parte verificável da regra deve ser representada com objetos Constraint e não apenas em fórmula textual."@pt .

fela:forbidsAggregatedRewriting a owl:DatatypeProperty ;
    rdfs:domain fela:NormativeRule ;
    rdfs:range xsd:boolean ;
    rdfs:label "forbids aggregated rewriting"@en ;
    rdfs:comment "Impede que a LLM reescreva múltiplas restrições explícitas em uma forma agregada equivalente, como max(), min() ou simplificações similares, salvo quando a norma originalmente o exigir."@pt .

#################################################################
# OPTIONAL IFC BINDING AIDS
#################################################################

fela:ifcEquivalentClassName a owl:DatatypeProperty ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:string ;
    rdfs:label "IFC equivalent class name"@en ;
    rdfs:comment "Nome da entidade IFC equivalente, quando usado apenas para interoperabilidade textual."@pt .

fela:ifcPropertySetName a owl:DatatypeProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:label "IFC property set name"@en ;
    rdfs:comment "Nome textual do Pset IFC associado à propriedade."@pt .

fela:ifcPropertyName a owl:DatatypeProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:label "IFC property name"@en ;
    rdfs:comment "Nome textual da propriedade IFC correspondente."@pt .

#################################################################
# RECOMMENDED DEFAULTS FOR UNIFORM RULE GENERATION
#################################################################

fela:DefaultAtomicRuleProfile a owl:NamedIndividual ;
    rdf:type fela:NormativeRule ;
    fela:mustBeAtomic true ;
    fela:mustUseStructuredConditions true ;
    fela:mustUseStructuredConstraints true ;
    fela:forbidsAggregatedRewriting true ;
    rdfs:label "Default Atomic Rule Profile"@en ;
    rdfs:comment "Perfil recomendado para orientar geração uniforme de regras por LLMs."@pt .