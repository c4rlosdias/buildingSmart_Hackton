@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix feso: <https://example.org/feso#> .
@prefix fr:   <https://example.org/feso-rules#> .

<https://example.org/feso-rules>
    a owl:Ontology ;
    owl:imports <https://example.org/feso> ;
    rdfs:label "FESO Rules Ontology (Complete)"@en ;
    owl:versionInfo "2.0.0" .

#################################################################
# BASIC REQUIREMENTS (IDS-COMPATIBLE)
#################################################################

fr:ExtinguisherMustHaveType
    a feso:NormativeRule ;
    rdfs:label "Extinguisher must have type" ;
    feso:appliesToClass feso:FireExtinguisher ;
    feso:hasRequirementText "Every extinguisher shall have a defined type." ;
    fr:isExpressibleInIDS true ;
    fr:isExpressibleInIDCS false .

fr:ExtinguisherMustHaveCapacity
    a feso:NormativeRule ;
    rdfs:label "Extinguisher must have capacity" ;
    feso:appliesToClass feso:FireExtinguisher ;
    feso:hasRequirementText "Every extinguisher shall have an extinguishing capacity rating." ;
    fr:isExpressibleInIDS true ;
    fr:isExpressibleInIDCS false .

fr:ExtinguisherMustBeCertified
    a feso:NormativeRule ;
    rdfs:label "Extinguisher must be certified" ;
    feso:appliesToClass feso:FireExtinguisher ;
    feso:hasRequirementText "All extinguishers shall be certified." ;
    fr:isExpressibleInIDS true ;
    fr:isExpressibleInIDCS false .

fr:AllowedExtinguisherTypes
    a feso:NormativeRule ;
    rdfs:label "Allowed extinguisher types" ;
    feso:hasRequirementText "Allowed types include Water, CO2, Foam, Dry Chemical BC, Dry Chemical ABC." ;
    fr:isExpressibleInIDS true ;
    fr:isExpressibleInIDCS false .

#################################################################
# MINIMUM PROVISION
#################################################################

fr:MinimumOneExtinguisherPerStorey
    a feso:NormativeRule ;
    rdfs:label "Minimum one extinguisher per storey" ;
    feso:appliesToClass feso:BuildingStorey ;
    feso:hasRequirementText "Each storey shall have at least one extinguisher." ;
    fr:isExpressibleInIDS true ;
    fr:isExpressibleInIDCS false .

#################################################################
# COMPATIBILITY RULES
#################################################################

fr:WaterCompatibility
    a feso:NormativeRule ;
    rdfs:label "Water compatibility" ;
    feso:hasAgentType feso:Water ;
    feso:allowsFireClass feso:ClassA ;
    feso:forbidsFireClass feso:ClassC ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:CO2Compatibility
    a feso:NormativeRule ;
    rdfs:label "CO2 compatibility" ;
    feso:hasAgentType feso:CO2 ;
    feso:allowsFireClass feso:ClassB, feso:ClassC ;
    feso:forbidsFireClass feso:ClassA ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:DryChemicalABCCompatibility
    a feso:NormativeRule ;
    rdfs:label "Dry Chemical ABC compatibility" ;
    feso:hasAgentType feso:DryChemicalABC ;
    feso:allowsFireClass feso:ClassA, feso:ClassB, feso:ClassC ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

#################################################################
# PRESSURE RULES
#################################################################

fr:DirectNonWeldedPressure
    a feso:NormativeRule ;
    feso:hasFormula "PR >= 5 * PNC AND PR >= 5 MPa" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:DirectWeldedPressure
    a feso:NormativeRule ;
    feso:hasFormula "PR >= 8 * PNC AND PR >= 5 MPa" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:IndirectNonWeldedPressure
    a feso:NormativeRule ;
    feso:hasFormula "PR >= 4 * PNC AND PR >= 5 MPa" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:IndirectWeldedPressure
    a feso:NormativeRule ;
    feso:hasFormula "PR >= 7 * PNC AND PR >= 5 MPa" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

#################################################################
# CLASS A COVERAGE
#################################################################

fr:LightRiskClassACoverage
    a feso:NormativeRule ;
    feso:hasFormula "RequiredUnits = ceil(area / 500)" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:ModerateRiskClassACoverage
    a feso:NormativeRule ;
    feso:hasFormula "RequiredUnits = ceil(area / 250)" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:HighRiskClassACoverage
    a feso:NormativeRule ;
    feso:hasFormula "RequiredUnits = ceil(area / 150)" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

#################################################################
# CLASS B COVERAGE
#################################################################

fr:ModerateRiskClassB
    a feso:NormativeRule ;
    feso:hasFormula "RequiredB = max(area * 1, 20)" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:HighRiskClassB
    a feso:NormativeRule ;
    feso:hasFormula "RequiredB = max(area * 2, 40)" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

#################################################################
# TRAVEL DISTANCE
#################################################################

fr:LightRiskTravelDistance
    a feso:NormativeRule ;
    feso:hasMaximumValue "20"^^xsd:decimal ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:ModerateRiskTravelDistance
    a feso:NormativeRule ;
    feso:hasMaximumValue "20"^^xsd:decimal ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:HighRiskTravelDistance
    a feso:NormativeRule ;
    feso:hasMaximumValue "15"^^xsd:decimal ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

#################################################################
# MOUNTING HEIGHT
#################################################################

fr:LowMassMountingHeight
    a feso:NormativeRule ;
    feso:hasFormula "mass <= 4 => height <= 1.60" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

fr:HighMassMountingHeight
    a feso:NormativeRule ;
    feso:hasFormula "mass > 4 => height <= 1.00" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .

#################################################################
# HYDROSTATIC TEST
#################################################################

fr:HydrostaticTestValidity
    a feso:NormativeRule ;
    feso:hasFormula "now - testDate <= 5 years" ;
    fr:isExpressibleInIDS false ;
    fr:isExpressibleInIDCS true .
