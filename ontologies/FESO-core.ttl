@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

@prefix feso: <https://example.org/feso#> .

<https://example.org/feso>
    a owl:Ontology ;
    rdfs:label "FESO Core Ontology"@en ;
    dct:title "FESO Core Ontology"@en ;
    dct:description "Core ontology for fire extinguisher standards, including domain concepts and rule metamodel."@en ;
    owl:versionInfo "2.0.0" .

#################################################################
# DOMAIN CLASSES
#################################################################

feso:FireExtinguisher a owl:Class ;
    rdfs:label "Fire Extinguisher"@en .

feso:BuildingStorey a owl:Class ;
    rdfs:label "Building Storey"@en .

feso:RiskClass a owl:Class .
feso:FireClass a owl:Class .
feso:ExtinguishingAgent a owl:Class .

#################################################################
# ENUMERATIONS
#################################################################

feso:LightRisk a feso:RiskClass ;
    rdfs:label "Light Risk"@en .

feso:ModerateRisk a feso:RiskClass ;
    rdfs:label "Moderate Risk"@en .

feso:HighRisk a feso:RiskClass ;
    rdfs:label "High Risk"@en .

feso:ClassA a feso:FireClass .
feso:ClassB a feso:FireClass .
feso:ClassC a feso:FireClass .

feso:Water a feso:ExtinguishingAgent .
feso:DryChemicalABC a feso:ExtinguishingAgent .
feso:DryChemicalBC a feso:ExtinguishingAgent .
feso:CO2 a feso:ExtinguishingAgent .
feso:Foam a feso:ExtinguishingAgent .

#################################################################
# PROPERTY DEFINITIONS (DOMAIN)
#################################################################

feso:BurstPressure a owl:DatatypeProperty ;
    rdfs:label "Burst Pressure"@en ;
    rdfs:comment "Pressão de Ruptura"@pt .

feso:NominalChargingPressure a owl:DatatypeProperty ;
    rdfs:label "Nominal Charging Pressure"@en ;
    rdfs:comment "Pressão Nominal de Carga"@pt .

feso:PressurisationMode a owl:DatatypeProperty ;
    rdfs:label "Pressurisation Mode"@en ;
    rdfs:comment "Tipo de Pressurização"@pt .

feso:JointType a owl:DatatypeProperty ;
    rdfs:label "Joint Type"@en ;
    rdfs:comment "Tipo de União"@pt .

feso:ExtinguisherType a owl:DatatypeProperty ;
    rdfs:label "Extinguisher Type"@en ;
    rdfs:comment "Tipo de Extintor"@pt .

feso:ExtinguishingCapacity a owl:DatatypeProperty ;
    rdfs:label "Extinguishing Capacity"@en ;
    rdfs:comment "Capacidade Extintora"@pt .

feso:IsCertified a owl:DatatypeProperty ;
    rdfs:label "Is Certified"@en ;
    rdfs:comment "Certificado"@pt .

feso:AgentMass a owl:DatatypeProperty ;
    rdfs:label "Agent Mass"@en ;
    rdfs:comment "Massa do Agente Extintor"@pt .

feso:HydrostaticTestDate a owl:DatatypeProperty ;
    rdfs:label "Hydrostatic Test Date"@en ;
    rdfs:comment "Data do Ensaio Hidrostático"@pt .

feso:RiskClassProperty a owl:ObjectProperty ;
    rdfs:label "Risk Class"@en ;
    rdfs:comment "Classe de Risco"@pt ;
    rdfs:range feso:RiskClass .

feso:MountingHeight a owl:DatatypeProperty ;
    rdfs:label "Mounting Height"@en ;
    rdfs:comment "Altura de Instalação"@pt .

feso:MaxTravelDistance a owl:DatatypeProperty ;
    rdfs:label "Maximum Travel Distance"@en ;
    rdfs:comment "Distância Máxima de Percurso"@pt .

feso:FloorArea a owl:DatatypeProperty ;
    rdfs:label "Floor Area"@en ;
    rdfs:comment "Área do Pavimento"@pt .

feso:LiquidSurfaceArea a owl:DatatypeProperty ;
    rdfs:label "Liquid Surface Area"@en ;
    rdfs:comment "Área de Superfície de Líquido Inflamável"@pt .

feso:FireClassProperty a owl:ObjectProperty ;
    rdfs:label "Fire Class"@en ;
    rdfs:comment "Classe de Fogo"@pt ;
    rdfs:range feso:FireClass .

#################################################################
# RULE METAMODEL
#################################################################

feso:NormativeRule a owl:Class .

feso:appliesToClass a owl:ObjectProperty ;
    rdfs:domain feso:NormativeRule ;
    rdfs:range owl:Class .

feso:dependsOnProperty a owl:ObjectProperty ;
    rdfs:domain feso:NormativeRule ;
    rdfs:range rdf:Property .

feso:hasAgentType a owl:ObjectProperty ;
    rdfs:range feso:ExtinguishingAgent .

feso:allowsFireClass a owl:ObjectProperty ;
    rdfs:range feso:FireClass .

feso:forbidsFireClass a owl:ObjectProperty ;
    rdfs:range feso:FireClass .

feso:hasFormula a owl:DatatypeProperty .
feso:hasRequirementText a owl:DatatypeProperty .
feso:hasConditionText a owl:DatatypeProperty .

feso:hasMinimumValue a owl:DatatypeProperty .
feso:hasMaximumValue a owl:DatatypeProperty .
feso:hasFactor a owl:DatatypeProperty .

feso:isExpressibleInIDS a owl:DatatypeProperty .
feso:isExpressibleInIDCS a owl:DatatypeProperty .
