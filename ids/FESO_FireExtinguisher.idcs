<?xml version="1.0" encoding="UTF-8"?>
<idcs:idcs xmlns:idcs="http://feso.org/IDCS"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <idcs:info>
    <idcs:title>FESO Constraint Specification</idcs:title>
    <idcs:description>
      Constraint specification for rules not expressible using IDS.
    </idcs:description>
    <idcs:version>1.0</idcs:version>
  </idcs:info>

  <!-- ===================================================== -->
  <!-- PRESSURE RULES -->
  <!-- ===================================================== -->

  <idcs:constraint name="DirectNonWeldedPressure">

    <idcs:annotation>
      <idcs:normativeText xml:lang="en">
        The rupture pressure shall be at least five times the nominal charging pressure and not less than 5 MPa for directly pressurised extinguishers with non-welded joints.
      </idcs:normativeText>
      <idcs:description>
        Cross-property relationship between PR and PNC with minimum threshold and conditional applicability.
      </idcs:description>
      <idcs:source>ABNT NBR 15808</idcs:source>
      <idcs:clause>Pressure resistance requirements</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>FireExtinguisher</idcs:entity>
    </idcs:appliesTo>

    <idcs:condition>
      <idcs:equals property="PressurisationMode" value="Direct"/>
      <idcs:equals property="JointType" value="NonWelded"/>
    </idcs:condition>

    <idcs:expression>
      <idcs:and>
        <idcs:greaterOrEqual>
          <idcs:property>PR</idcs:property>
          <idcs:multiply>
            <idcs:literal>5</idcs:literal>
            <idcs:property>PNC</idcs:property>
          </idcs:multiply>
        </idcs:greaterOrEqual>

        <idcs:greaterOrEqual>
          <idcs:property>PR</idcs:property>
          <idcs:literal unit="MPa">5</idcs:literal>
        </idcs:greaterOrEqual>
      </idcs:and>
    </idcs:expression>
  </idcs:constraint>

  <!-- ===================================================== -->
  <!-- CLASS B - FLAMMABLE LIQUIDS -->
  <!-- ===================================================== -->

  <idcs:constraint name="ModerateRiskClassB">

    <idcs:annotation>
      <idcs:normativeText>
        For moderate risk, one unit of class B extinguishing capacity shall be provided per square metre of flammable liquid surface, with a minimum of 20B.
      </idcs:normativeText>
      <idcs:description>
        Required extinguishing capacity is proportional to liquid surface area with a minimum threshold.
      </idcs:description>
      <idcs:source>ABNT NBR 12693</idcs:source>
      <idcs:clause>7.3</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>BuildingStorey</idcs:entity>
    </idcs:appliesTo>

    <idcs:condition>
      <idcs:equals property="RiskClass" value="Moderate"/>
    </idcs:condition>

    <idcs:expression>
      <idcs:max>
        <idcs:multiply>
          <idcs:property>LiquidSurfaceArea</idcs:property>
          <idcs:literal>1</idcs:literal>
        </idcs:multiply>
        <idcs:literal>20</idcs:literal>
      </idcs:max>
    </idcs:expression>
  </idcs:constraint>

  <idcs:constraint name="HighRiskClassB">

    <idcs:annotation>
      <idcs:normativeText>
        For high risk, two units of class B extinguishing capacity shall be provided per square metre of flammable liquid surface, with a minimum of 40B.
      </idcs:normativeText>
      <idcs:description>
        Increased extinguishing capacity requirement proportional to hazard level and area.
      </idcs:description>
      <idcs:source>ABNT NBR 12693</idcs:source>
      <idcs:clause>7.3</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>BuildingStorey</idcs:entity>
    </idcs:appliesTo>

    <idcs:condition>
      <idcs:equals property="RiskClass" value="High"/>
    </idcs:condition>

    <idcs:expression>
      <idcs:max>
        <idcs:multiply>
          <idcs:property>LiquidSurfaceArea</idcs:property>
          <idcs:literal>2</idcs:literal>
        </idcs:multiply>
        <idcs:literal>40</idcs:literal>
      </idcs:max>
    </idcs:expression>
  </idcs:constraint>

  <!-- ===================================================== -->
  <!-- TRAVEL DISTANCE -->
  <!-- ===================================================== -->

  <idcs:constraint name="HighRiskTravelDistance">

    <idcs:annotation>
      <idcs:normativeText>
        The maximum travel distance to reach a fire extinguisher shall not exceed 15 metres for high risk areas.
      </idcs:normativeText>
      <idcs:description>
        Spatial constraint based on accessibility distance within the protected area.
      </idcs:description>
      <idcs:source>ABNT NBR 12693</idcs:source>
      <idcs:clause>Travel distance requirements</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>BuildingStorey</idcs:entity>
    </idcs:appliesTo>

    <idcs:condition>
      <idcs:equals property="RiskClass" value="High"/>
    </idcs:condition>

    <idcs:expression>
      <idcs:lessOrEqual>
        <idcs:property>MaxTravelDistance</idcs:property>
        <idcs:literal unit="m">15</idcs:literal>
      </idcs:lessOrEqual>
    </idcs:expression>
  </idcs:constraint>

  <!-- ===================================================== -->
  <!-- MOUNTING HEIGHT -->
  <!-- ===================================================== -->

  <idcs:constraint name="LowMassMountingHeight">

    <idcs:annotation>
      <idcs:normativeText>
        Fire extinguishers with mass up to 4 kg shall be installed so that the handle height does not exceed 1.60 metres.
      </idcs:normativeText>
      <idcs:description>
        Conditional constraint relating extinguisher mass to installation height.
      </idcs:description>
      <idcs:source>ABNT NBR 12693</idcs:source>
      <idcs:clause>Installation height requirements</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>FireExtinguisher</idcs:entity>
    </idcs:appliesTo>

    <idcs:condition>
      <idcs:lessOrEqual property="AgentMass_kg" value="4"/>
    </idcs:condition>

    <idcs:expression>
      <idcs:lessOrEqual>
        <idcs:property>MountingHeight_m</idcs:property>
        <idcs:literal unit="m">1.60</idcs:literal>
      </idcs:lessOrEqual>
    </idcs:expression>
  </idcs:constraint>

  <idcs:constraint name="HighMassMountingHeight">

    <idcs:annotation>
      <idcs:normativeText>
        Fire extinguishers with mass greater than 4 kg shall be installed so that the handle height does not exceed 1.00 metre.
      </idcs:normativeText>
      <idcs:description>
        Conditional constraint relating higher mass to lower mounting height.
      </idcs:description>
      <idcs:source>ABNT NBR 12693</idcs:source>
      <idcs:clause>Installation height requirements</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>FireExtinguisher</idcs:entity>
    </idcs:appliesTo>

    <idcs:condition>
      <idcs:greater property="AgentMass_kg" value="4"/>
    </idcs:condition>

    <idcs:expression>
      <idcs:lessOrEqual>
        <idcs:property>MountingHeight_m</idcs:property>
        <idcs:literal unit="m">1.00</idcs:literal>
      </idcs:lessOrEqual>
    </idcs:expression>
  </idcs:constraint>

  <!-- ===================================================== -->
  <!-- AGENT COMPATIBILITY -->
  <!-- ===================================================== -->

  <idcs:constraint name="WaterCompatibility">

    <idcs:annotation>
      <idcs:normativeText>
        Water extinguishers shall be used for Class A fires and shall not be used for Class C fires.
      </idcs:normativeText>
      <idcs:description>
        Compatibility constraint between extinguishing agent and fire class.
      </idcs:description>
      <idcs:source>ABNT NBR 15808</idcs:source>
      <idcs:clause>Agent compatibility</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>FireExtinguisher</idcs:entity>
    </idcs:appliesTo>

    <idcs:condition>
      <idcs:equals property="ExtinguisherType" value="Water"/>
    </idcs:condition>

    <idcs:expression>
      <idcs:not>
        <idcs:equals property="FireClass" value="C"/>
      </idcs:not>
    </idcs:expression>
  </idcs:constraint>

  <!-- ===================================================== -->
  <!-- HYDROSTATIC TEST -->
  <!-- ===================================================== -->

  <idcs:constraint name="HydrostaticTestValidity">

    <idcs:annotation>
      <idcs:normativeText>
        The hydrostatic test shall be performed at intervals not exceeding five years.
      </idcs:normativeText>
      <idcs:description>
        Time-based validation comparing current date with last hydrostatic test.
      </idcs:description>
      <idcs:source>ABNT NBR 15808 / NBR 12962</idcs:source>
      <idcs:clause>Maintenance requirements</idcs:clause>
    </idcs:annotation>

    <idcs:appliesTo>
      <idcs:entity>FireExtinguisher</idcs:entity>
    </idcs:appliesTo>

    <idcs:expression>
      <idcs:lessOrEqual>
        <idcs:dateDifference unit="years">
          <idcs:property>HydrostaticTestDate</idcs:property>
          <idcs:currentDate/>
        </idcs:dateDifference>
        <idcs:literal>5</idcs:literal>
      </idcs:lessOrEqual>
    </idcs:expression>
  </idcs:constraint>

</idcs:idcs>
