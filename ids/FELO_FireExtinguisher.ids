<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://standards.buildingsmart.org/IDS ids.xsd">

  <ids:info>
    <ids:title>FELA Fire Extinguisher IDS</ids:title>
    <ids:description>
      IDS specification derived from FELA ontology for portable fire extinguishers.
      Includes all requirements expressible in IDS.
    </ids:description>
    <ids:author>fela@infobim.org</ids:author>
  </ids:info>

  <!-- ===================================================== -->
  <!-- CORE PROPERTIES -->
  <!-- ===================================================== -->

    <ids:specifications>
  <ids:specification name="Fire Extinguisher Core Properties" ifcVersion="IFC4 IFC4X3_ADD2">

    <ids:annotation>
      <ids:normativeText>
        Fire extinguishers shall be properly identified and classified according to their type, extinguishing capacity, certification status and agent mass.
      </ids:normativeText>
      <ids:description>
        Basic data required for all extinguisher definitions.
      </ids:description>
      <ids:source>FELA ontology derived from ABNT NBR 15808</ids:source>
      <ids:clause>General requirements</ids:clause>
      <ids:applicabilityNote>
        Extintores devem ser corretamente identificados quanto ao tipo, capacidade extintora, certificação e massa do agente.
      </ids:applicabilityNote>
    </ids:annotation>

    <ids:applicability>
      <ids:entity>
        <ids:name><ids:simpleValue>IfcFireSuppressionTerminalType</ids:simpleValue></ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>ExtinguisherType</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCLABEL</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>ExtinguishingCapacity</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCLABEL</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>IsCertified</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCBOOLEAN</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>AgentMass</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCMASSMEASURE</ids:simpleValue></ids:dataType>
      </ids:property>

    </ids:requirements>

  </ids:specification>

  <!-- ===================================================== -->
  <!-- TYPE ENUMERATION -->
  <!-- ===================================================== -->

  <ids:specification name="Allowed Extinguisher Types" ifcVersion="IFC4 IFC4X3_ADD2">

    <ids:annotation>
      <ids:normativeText>
        The extinguishing agent type shall belong to the recognised extinguisher categories.
      </ids:normativeText>
      <ids:description>
        Restricts extinguisher types to standardised agent families.
      </ids:description>
      <ids:source>FELA ontology</ids:source>
      <ids:applicabilityNote>
        O tipo de extintor deve pertencer a uma categoria reconhecida.
      </ids:applicabilityNote>
    </ids:annotation>

    <ids:applicability>
      <ids:entity>
        <ids:name><ids:simpleValue>IfcFireSuppressionTerminalType</ids:simpleValue></ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>ExtinguisherType</ids:simpleValue></ids:name>
        <ids:allowedValues>
          <ids:value>Water</ids:value>
          <ids:value>CO2</ids:value>
          <ids:value>Foam</ids:value>
          <ids:value>DryChemicalABC</ids:value>
          <ids:value>DryChemicalBC</ids:value>
        </ids:allowedValues>
      </ids:property>

    </ids:requirements>

  </ids:specification>

  <!-- ===================================================== -->
  <!-- CERTIFICATION -->
  <!-- ===================================================== -->

  <ids:specification name="Certification Requirement" ifcVersion="IFC4 IFC4X3_ADD2">

    <ids:annotation>
      <ids:normativeText>
        All extinguishers shall be certified.
      </ids:normativeText>
      <ids:description>
        Ensures certification is explicitly declared and true.
      </ids:description>
      <ids:source>FELA ontology</ids:source>
      <ids:applicabilityNote>
        Todos os extintores devem ser certificados.
      </ids:applicabilityNote>
    </ids:annotation>

    <ids:applicability>
      <ids:entity>
        <ids:name><ids:simpleValue>IfcFireSuppressionTerminalType</ids:simpleValue></ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>IsCertified</ids:simpleValue></ids:name>
        <ids:expectedValue><ids:simpleValue>true</ids:simpleValue></ids:expectedValue>
      </ids:property>

    </ids:requirements>

  </ids:specification>

  <!-- ===================================================== -->
  <!-- CAPACITY FORMAT -->
  <!-- ===================================================== -->

  <ids:specification name="Capacity Format" ifcVersion="IFC4 IFC4X3_ADD2">

    <ids:annotation>
      <ids:normativeText>
        The extinguishing capacity shall follow standard rating notation.
      </ids:normativeText>
      <ids:description>
        Validates extinguisher rating string format.
      </ids:description>
      <ids:source>FELA ontology</ids:source>
      <ids:applicabilityNote>
        A capacidade extintora deve seguir a notação padrão.
      </ids:applicabilityNote>
    </ids:annotation>

    <ids:applicability>
      <ids:entity>
        <ids:name><ids:simpleValue>IfcFireSuppressionTerminalType</ids:simpleValue></ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>ExtinguishingCapacity</ids:simpleValue></ids:name>
        <ids:pattern><ids:simpleValue>^([0-9]+A)?(:[0-9]+B)?(:C)?$</ids:simpleValue></ids:pattern>
      </ids:property>

    </ids:requirements>

  </ids:specification>

  <!-- ===================================================== -->
  <!-- MECHANICAL DATA PRESENCE -->
  <!-- ===================================================== -->

  <ids:specification name="Mechanical Properties Presence" ifcVersion="IFC4 IFC4X3_ADD2">

    <ids:annotation>
      <ids:normativeText>
        Mechanical properties required for pressure resistance verification shall be provided.
      </ids:normativeText>
      <ids:description>
        Required input for IDCS pressure rules.
      </ids:description>
      <ids:source>FELA ontology</ids:source>
      <ids:applicabilityNote>
        Propriedades mecânicas necessárias devem ser informadas.
      </ids:applicabilityNote>
    </ids:annotation>

    <ids:applicability>
      <ids:entity>
        <ids:name><ids:simpleValue>IfcFireSuppressionTerminalType</ids:simpleValue></ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_Mechanical</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>BurstPressure</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCPRESSUREMEASURE</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_Mechanical</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>NominalChargingPressure</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCPRESSUREMEASURE</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_Mechanical</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>PressurisationMode</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCLABEL</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_Mechanical</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>JointType</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCLABEL</ids:simpleValue></ids:dataType>
      </ids:property>

    </ids:requirements>

  </ids:specification>

  <!-- ===================================================== -->
  <!-- INSTALLATION + CONTEXT -->
  <!-- ===================================================== -->

  <ids:specification name="Installation and Context Data" ifcVersion="IFC4 IFC4X3_ADD2">

    <ids:annotation>
      <ids:normativeText>
        Installation and contextual properties required for compliance shall be provided.
      </ids:normativeText>
      <ids:description>
        Provides input data for spatial and contextual rules.
      </ids:description>
      <ids:source>FELA ontology</ids:source>
      <ids:applicabilityNote>
        Propriedades de instalação e contexto devem ser informadas.
      </ids:applicabilityNote>
    </ids:annotation>

    <ids:applicability>
      <ids:entity>
        <ids:name><ids:simpleValue>IfcFireSuppressionTerminalType</ids:simpleValue></ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_Installation</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>RiskClass</ids:simpleValue></ids:name>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_Installation</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>MountingHeight</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCLENGTHMEASURE</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_Spatial</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>MaxTravelDistance</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCLENGTHMEASURE</ids:simpleValue></ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireSafety_Context</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>FireClass</ids:simpleValue></ids:name>
      </ids:property>

      <ids:property>
        <ids:propertySet><ids:simpleValue>Pset_FireExtinguisher_FELA</ids:simpleValue></ids:propertySet>
        <ids:name><ids:simpleValue>HydrostaticTestDate</ids:simpleValue></ids:name>
        <ids:dataType><ids:simpleValue>IFCDATE</ids:simpleValue></ids:dataType>
      </ids:property>

    </ids:requirements>

  </ids:specification>

    </ids:specifications>
</ids:ids>
