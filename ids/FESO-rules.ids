            <requirements />
        </specification>
        <specification name="Allowed extinguisher types" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Allowed types include Water, CO2, Foam, Dry Chemical BC, Dry Chemical ABC.">
            <applicability minOccurs="1" maxOccurs="1" />
            <requirements />
        </specification>
        <specification name="Minimum one extinguisher per storey" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Each storey shall have at least one extinguisher.">
            <applicability minOccurs="1" maxOccurs="1" />
            <requirements />
        </specification>
        <specification name="Extinguisher must have capacity" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Every extinguisher shall have an extinguishing capacity rating.">
