    <specifications>
        <specification name="Extinguisher must be certified" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="All extinguishers shall be certified.">
            <applicability minOccurs="1" maxOccurs="1" />
            <requirements />
        </specification>
        <specification name="Extinguisher must have type" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Every extinguisher shall have a defined type.">
