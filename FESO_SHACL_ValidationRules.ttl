@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix feso: <https://example.org/feso#> .

#################################################################
# CORE ENUMS EXPECTED BY THE SHACL
#################################################################

# Expected classes:
# feso:FireExtinguisher
# feso:BuildingStorey

# Expected individuals / controlled values:
# Agents:
#   feso:Water
#   feso:DryChemicalABC
#   feso:DryChemicalBC
#   feso:CO2
#   feso:Foam
#
# Fire classes:
#   feso:ClassA
#   feso:ClassB
#   feso:ClassC
#
# Risk classes:
#   feso:LightRisk
#   feso:ModerateRisk
#   feso:HighRisk

#################################################################
# MAIN SHAPE
#################################################################

feso:FireExtinguisherShape
    a sh:NodeShape ;
    sh:targetClass feso:FireExtinguisher ;
    rdfs:label "Fire extinguisher validation shape" ;

    #############################################################
    # Mandatory core properties
    #############################################################

    sh:property [
        sh:path feso:hasAgent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            feso:Water
            feso:DryChemicalABC
            feso:DryChemicalBC
            feso:CO2
            feso:Foam
        ) ;
        sh:message "Each fire extinguisher must declare exactly one valid extinguishing agent." ;
    ] ;

    sh:property [
        sh:path feso:hasCapacityRating ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([0-9]+A)?(:?[0-9]+B)?(:C)?$" ;
        sh:message "Capacity rating must be present and follow a pattern such as 2A, 10B:C or 2A:20B:C." ;
    ] ;

    sh:property [
        sh:path feso:isCertified ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "Extinguisher must be certified." ;
    ] ;

    sh:property [
        sh:path feso:hasAgentMassKg ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "Agent mass must be informed as a positive decimal value." ;
    ] ;

    sh:property [
        sh:path feso:manufactureDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Manufacture date, when provided, must be a valid date." ;
    ] ;

    sh:property [
        sh:path feso:installedIn ;
        sh:maxCount 1 ;
        sh:class feso:BuildingStorey ;
        sh:message "installedIn must point to a building storey when present." ;
    ] ;

    #############################################################
    # Installation / risk properties
    #############################################################

    sh:property [
        sh:path feso:hasRiskClass ;
        sh:maxCount 1 ;
        sh:in (
            feso:LightRisk
            feso:ModerateRisk
            feso:HighRisk
        ) ;
        sh:message "Risk class, when provided, must be LightRisk, ModerateRisk, or HighRisk." ;
    ] ;

    sh:property [
        sh:path feso:coversAreaM2 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "Covered area must be a non-negative decimal value in m²." ;
    ] ;

    sh:property [
        sh:path feso:maxTravelDistanceM ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "Maximum travel distance must be a non-negative decimal value in metres." ;
    ] ;

    sh:property [
        sh:path feso:mountingHeightM ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "Mounting height must be a non-negative decimal value in metres." ;
    ] ;

    #############################################################
    # Pressure / lifecycle properties
    #############################################################

    sh:property [
        sh:path feso:hasPNC ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:message "PNC must be a positive decimal value." ;
    ] ;

    sh:property [
        sh:path feso:hasPR ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:message "PR must be a positive decimal value." ;
    ] ;

    sh:property [
        sh:path feso:hasPressurisationMode ;
        sh:maxCount 1 ;
        sh:in (
            feso:DirectPressurisation
            feso:IndirectPressurisation
        ) ;
        sh:message "Pressurisation mode, when provided, must be direct or indirect." ;
    ] ;

    sh:property [
        sh:path feso:hasJointType ;
        sh:maxCount 1 ;
        sh:in (
            feso:WeldedJoints
            feso:NonWeldedJoints
        ) ;
        sh:message "Joint type, when provided, must be welded or non-welded." ;
    ] ;

    sh:property [
        sh:path feso:nextHydrostaticTestDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "Next hydrostatic test date, when provided, must be a valid date." ;
    ] ;

    sh:property [
        sh:path feso:isDisposable ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Disposable flag, when provided, must be boolean." ;
    ] ;

    #############################################################
    # Compatibility of agent vs supported fire classes
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Water extinguishers cannot protect Class C." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgent feso:Water ;
                      feso:protectsFireClass feso:ClassC .
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "DryChemicalBC extinguishers cannot protect Class A." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgent feso:DryChemicalBC ;
                      feso:protectsFireClass feso:ClassA .
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "CO2 extinguishers cannot protect Class A." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgent feso:CO2 ;
                      feso:protectsFireClass feso:ClassA .
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Foam extinguishers cannot protect Class C." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgent feso:Foam ;
                      feso:protectsFireClass feso:ClassC .
            }
        """ ;
    ] ;

    #############################################################
    # Optional positive compatibility checks
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Water extinguishers should only declare protection for Class A." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgent feso:Water ;
                      feso:protectsFireClass ?fc .
                FILTER (?fc NOT IN (feso:ClassA))
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "CO2 extinguishers should only declare protection for Classes B and C." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgent feso:CO2 ;
                      feso:protectsFireClass ?fc .
                FILTER (?fc NOT IN (feso:ClassB, feso:ClassC))
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "DryChemicalABC extinguishers should only declare protection for Classes A, B and C." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgent feso:DryChemicalABC ;
                      feso:protectsFireClass ?fc .
                FILTER (?fc NOT IN (feso:ClassA, feso:ClassB, feso:ClassC))
            }
        """ ;
    ] ;

    #############################################################
    # Coverage rules by risk class (NBR 12693)
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For LightRisk, covered area must not exceed 500 m²." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasRiskClass feso:LightRisk ;
                      feso:coversAreaM2 ?a .
                FILTER (?a > 500)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For ModerateRisk, covered area must not exceed 250 m²." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasRiskClass feso:ModerateRisk ;
                      feso:coversAreaM2 ?a .
                FILTER (?a > 250)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For HighRisk, covered area must not exceed 150 m²." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasRiskClass feso:HighRisk ;
                      feso:coversAreaM2 ?a .
                FILTER (?a > 150)
            }
        """ ;
    ] ;

    #############################################################
    # Travel distance rules
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For LightRisk and ModerateRisk, maximum travel distance must not exceed 20 m." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasRiskClass ?risk ;
                      feso:maxTravelDistanceM ?d .
                FILTER (?risk IN (feso:LightRisk, feso:ModerateRisk))
                FILTER (?d > 20)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For HighRisk, maximum travel distance must not exceed 15 m." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasRiskClass feso:HighRisk ;
                      feso:maxTravelDistanceM ?d .
                FILTER (?d > 15)
            }
        """ ;
    ] ;

    #############################################################
    # Mounting height rules based on mass
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If agent mass is up to 4 kg, mounting height must not exceed 1.60 m." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgentMassKg ?m ;
                      feso:mountingHeightM ?h .
                FILTER (?m <= 4 && ?h > 1.60)
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If agent mass is greater than 4 kg, mounting height must not exceed 1.00 m." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasAgentMassKg ?m ;
                      feso:mountingHeightM ?h .
                FILTER (?m > 4 && ?h > 1.00)
            }
        """ ;
    ] ;

    #############################################################
    # Pressure rules
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For direct pressurisation with non-welded joints, PR must be at least 5 × PNC and at least 5 MPa." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasPressurisationMode feso:DirectPressurisation ;
                      feso:hasJointType feso:NonWeldedJoints ;
                      feso:hasPNC ?pnc ;
                      feso:hasPR ?pr .
                FILTER ( ?pr < (5 * ?pnc) || ?pr < 5 )
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For direct pressurisation with welded joints, PR must be at least 8 × PNC and at least 5 MPa." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasPressurisationMode feso:DirectPressurisation ;
                      feso:hasJointType feso:WeldedJoints ;
                      feso:hasPNC ?pnc ;
                      feso:hasPR ?pr .
                FILTER ( ?pr < (8 * ?pnc) || ?pr < 5 )
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For indirect pressurisation with non-welded joints, PR must be at least 4 × PNC and at least 5 MPa." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasPressurisationMode feso:IndirectPressurisation ;
                      feso:hasJointType feso:NonWeldedJoints ;
                      feso:hasPNC ?pnc ;
                      feso:hasPR ?pr .
                FILTER ( ?pr < (4 * ?pnc) || ?pr < 5 )
            }
        """ ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For indirect pressurisation with welded joints, PR must be at least 7 × PNC and at least 5 MPa." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:hasPressurisationMode feso:IndirectPressurisation ;
                      feso:hasJointType feso:WeldedJoints ;
                      feso:hasPNC ?pnc ;
                      feso:hasPR ?pr .
                FILTER ( ?pr < (7 * ?pnc) || ?pr < 5 )
            }
        """ ;
    ] ;

    #############################################################
    # Disposable extinguisher rule
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Disposable extinguishers must not exceed 1 kg of agent mass." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:isDisposable true ;
                      feso:hasAgentMassKg ?m .
                FILTER (?m > 1)
            }
        """ ;
    ] ;

    #############################################################
    # Hydrostatic test expiry
    #############################################################

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "The next hydrostatic test date must not be in the past." ;
        sh:select """
            SELECT $this
            WHERE {
                $this feso:nextHydrostaticTestDate ?d .
                FILTER (?d < NOW())
            }
        """ ;
    ] .

#################################################################
# STOREY SHAPE
#################################################################

feso:BuildingStoreyShape
    a sh:NodeShape ;
    sh:targetClass feso:BuildingStorey ;
    rdfs:label "Building storey validation shape" ;

    sh:property [
        sh:path [ sh:inversePath feso:installedIn ] ;
        sh:minCount 1 ;
        sh:class feso:FireExtinguisher ;
        sh:message "Each building storey must have at least one fire extinguisher installed." ;
    ] .

#################################################################
# OPTIONAL SHAPE FOR PROTECTS FIRE CLASS
#################################################################

feso:ProtectsFireClassShape
    a sh:PropertyShape ;
    sh:targetClass feso:FireExtinguisher ;
    sh:path feso:protectsFireClass ;
    sh:in (
        feso:ClassA
        feso:ClassB
        feso:ClassC
    ) ;
    sh:message "protectsFireClass must reference only ClassA, ClassB, or ClassC." .