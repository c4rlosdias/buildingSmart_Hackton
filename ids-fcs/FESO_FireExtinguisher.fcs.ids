<?xml version="1.0" encoding="UTF-8"?>
<fcs:fcs xmlns:fcs="http://feso.org/FCS"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <fcs:info>
    <fcs:title>FESO Constraint Specification</fcs:title>
    <fcs:description>
      Constraint specification for rules not expressible using IDS.
    </fcs:description>
    <fcs:version>1.0</fcs:version>
  </fcs:info>

  <!-- ===================================================== -->
  <!-- PRESSURE RULES -->
  <!-- ===================================================== -->

  <fcs:constraint name="DirectNonWeldedPressure">
    <fcs:appliesTo>
      <fcs:entity>FireExtinguisher</fcs:entity>
    </fcs:appliesTo>

    <fcs:condition>
      <fcs:equals property="PressurisationMode" value="Direct"/>
      <fcs:equals property="JointType" value="NonWelded"/>
    </fcs:condition>

    <fcs:expression>
      <fcs:and>
        <fcs:greaterOrEqual>
          <fcs:property>PR</fcs:property>
          <fcs:multiply>
            <fcs:literal>5</fcs:literal>
            <fcs:property>PNC</fcs:property>
          </fcs:multiply>
        </fcs:greaterOrEqual>

        <fcs:greaterOrEqual>
          <fcs:property>PR</fcs:property>
          <fcs:literal unit="MPa">5</fcs:literal>
        </fcs:greaterOrEqual>
      </fcs:and>
    </fcs:expression>
  </fcs:constraint>

  <!-- ===================================================== -->
  <!-- CLASS B - FLAMMABLE LIQUIDS -->
  <!-- ===================================================== -->

  <fcs:constraint name="ModerateRiskClassB">
    <fcs:appliesTo>
      <fcs:entity>BuildingStorey</fcs:entity>
    </fcs:appliesTo>

    <fcs:condition>
      <fcs:equals property="RiskClass" value="Moderate"/>
    </fcs:condition>

    <fcs:expression>
      <fcs:max>
        <fcs:multiply>
          <fcs:property>LiquidSurfaceArea</fcs:property>
          <fcs:literal>1</fcs:literal>
        </fcs:multiply>
        <fcs:literal>20</fcs:literal>
      </fcs:max>
    </fcs:expression>
  </fcs:constraint>

  <fcs:constraint name="HighRiskClassB">
    <fcs:appliesTo>
      <fcs:entity>BuildingStorey</fcs:entity>
    </fcs:appliesTo>

    <fcs:condition>
      <fcs:equals property="RiskClass" value="High"/>
    </fcs:condition>

    <fcs:expression>
      <fcs:max>
        <fcs:multiply>
          <fcs:property>LiquidSurfaceArea</fcs:property>
          <fcs:literal>2</fcs:literal>
        </fcs:multiply>
        <fcs:literal>40</fcs:literal>
      </fcs:max>
    </fcs:expression>
  </fcs:constraint>

  <!-- ===================================================== -->
  <!-- TRAVEL DISTANCE -->
  <!-- ===================================================== -->

  <fcs:constraint name="HighRiskTravelDistance">
    <fcs:appliesTo>
      <fcs:entity>BuildingStorey</fcs:entity>
    </fcs:appliesTo>

    <fcs:condition>
      <fcs:equals property="RiskClass" value="High"/>
    </fcs:condition>

    <fcs:expression>
      <fcs:lessOrEqual>
        <fcs:property>MaxTravelDistance</fcs:property>
        <fcs:literal unit="m">15</fcs:literal>
      </fcs:lessOrEqual>
    </fcs:expression>
  </fcs:constraint>

  <!-- ===================================================== -->
  <!-- MOUNTING HEIGHT -->
  <!-- ===================================================== -->

  <fcs:constraint name="LowMassMountingHeight">
    <fcs:appliesTo>
      <fcs:entity>FireExtinguisher</fcs:entity>
    </fcs:appliesTo>

    <fcs:condition>
      <fcs:lessOrEqual property="AgentMass_kg" value="4"/>
    </fcs:condition>

    <fcs:expression>
      <fcs:lessOrEqual>
        <fcs:property>MountingHeight_m</fcs:property>
        <fcs:literal unit="m">1.60</fcs:literal>
      </fcs:lessOrEqual>
    </fcs:expression>
  </fcs:constraint>

  <fcs:constraint name="HighMassMountingHeight">
    <fcs:appliesTo>
      <fcs:entity>FireExtinguisher</fcs:entity>
    </fcs:appliesTo>

    <fcs:condition>
      <fcs:greater property="AgentMass_kg" value="4"/>
    </fcs:condition>

    <fcs:expression>
      <fcs:lessOrEqual>
        <fcs:property>MountingHeight_m</fcs:property>
        <fcs:literal unit="m">1.00</fcs:literal>
      </fcs:lessOrEqual>
    </fcs:expression>
  </fcs:constraint>

  <!-- ===================================================== -->
  <!-- AGENT COMPATIBILITY -->
  <!-- ===================================================== -->

  <fcs:constraint name="WaterCompatibility">
    <fcs:appliesTo>
      <fcs:entity>FireExtinguisher</fcs:entity>
    </fcs:appliesTo>

    <fcs:condition>
      <fcs:equals property="ExtinguisherType" value="Water"/>
    </fcs:condition>

    <fcs:expression>
      <fcs:not>
        <fcs:equals property="FireClass" value="C"/>
      </fcs:not>
    </fcs:expression>
  </fcs:constraint>

  <!-- ===================================================== -->
  <!-- HYDROSTATIC TEST -->
  <!-- ===================================================== -->

  <fcs:constraint name="HydrostaticTestValidity">
    <fcs:appliesTo>
      <fcs:entity>FireExtinguisher</fcs:entity>
    </fcs:appliesTo>

    <fcs:expression>
      <fcs:lessOrEqual>
        <fcs:dateDifference unit="years">
          <fcs:property>HydrostaticTestDate</fcs:property>
          <fcs:currentDate/>
        </fcs:dateDifference>
        <fcs:literal>5</fcs:literal>
      </fcs:lessOrEqual>
    </fcs:expression>
  </fcs:constraint>

</fcs:fcs>
