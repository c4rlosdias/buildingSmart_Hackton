<?xml version="1.0" encoding="UTF-8"?>
<ids:ids xmlns:ids="http://standards.buildingsmart.org/IDS"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://standards.buildingsmart.org/IDS ids.xsd">

  <ids:info>
    <ids:title>Fire Extinguisher Standard Model (FESM)</ids:title>
    <ids:description>Executable specification for fire extinguishers based on NBR 15808 and NBR 12693</ids:description>
    <ids:version>1.0</ids:version>
    <ids:author>Hackathon Prototype</ids:author>
  </ids:info>

  <!-- ===================================================== -->
  <!-- SPEC 1 — ENTITY REQUIREMENT -->
  <!-- ===================================================== -->

  <ids:specification name="Fire Extinguisher Entity">
    <ids:applicability>
      <ids:entity>
        <ids:name>IfcFireSuppressionTerminal</ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>
      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_FESM</ids:propertySet>
        <ids:name>ExtinguisherType</ids:name>
        <ids:dataType>IFCLABEL</ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_FESM</ids:propertySet>
        <ids:name>ExtinguishingCapacity</ids:name>
        <ids:dataType>IFCLABEL</ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_FESM</ids:propertySet>
        <ids:name>AgentMass_kg</ids:name>
        <ids:dataType>IFCMASSMEASURE</ids:dataType>
      </ids:property>

      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_FESM</ids:propertySet>
        <ids:name>IsCertified</ids:name>
        <ids:dataType>IFCBOOLEAN</ids:dataType>
      </ids:property>
    </ids:requirements>
  </ids:specification>

  <!-- ===================================================== -->
  <!-- SPEC 2 — VALID TYPES -->
  <!-- ===================================================== -->

  <ids:specification name="Valid Extinguisher Types">
    <ids:applicability>
      <ids:entity>
        <ids:name>IfcFireSuppressionTerminal</ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>
      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_FESM</ids:propertySet>
        <ids:name>ExtinguisherType</ids:name>
        <ids:allowedValues>
          <ids:value>Water</ids:value>
          <ids:value>DryChemicalABC</ids:value>
          <ids:value>DryChemicalBC</ids:value>
          <ids:value>CO2</ids:value>
          <ids:value>Foam</ids:value>
        </ids:allowedValues>
      </ids:property>
    </ids:requirements>
  </ids:specification>

  <!-- ===================================================== -->
  <!-- SPEC 3 — CERTIFICATION REQUIRED -->
  <!-- ===================================================== -->

  <ids:specification name="Certification Requirement">
    <ids:applicability>
      <ids:entity>
        <ids:name>IfcFireSuppressionTerminal</ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>
      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_FESM</ids:propertySet>
        <ids:name>IsCertified</ids:name>
        <ids:expectedValue>true</ids:expectedValue>
      </ids:property>
    </ids:requirements>
  </ids:specification>

  <!-- ===================================================== -->
  <!-- SPEC 4 — CAPACITY FORMAT -->
  <!-- ===================================================== -->

  <ids:specification name="Capacity Format">
    <ids:applicability>
      <ids:entity>
        <ids:name>IfcFireSuppressionTerminal</ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>
      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_FESM</ids:propertySet>
        <ids:name>ExtinguishingCapacity</ids:name>
        <ids:pattern>^[0-9]+A(:[0-9]+B)?(:C)?$</ids:pattern>
      </ids:property>
    </ids:requirements>
  </ids:specification>

  <!-- ===================================================== -->
  <!-- SPEC 5 — INSTALLATION (NBR 12693) -->
  <!-- ===================================================== -->

  <ids:specification name="Installation Requirements">
    <ids:applicability>
      <ids:entity>
        <ids:name>IfcFireSuppressionTerminal</ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>

      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_Installation</ids:propertySet>
        <ids:name>RiskClass</ids:name>
        <ids:allowedValues>
          <ids:value>Light</ids:value>
          <ids:value>Moderate</ids:value>
          <ids:value>High</ids:value>
        </ids:allowedValues>
      </ids:property>

      <ids:property>
        <ids:propertySet>Pset_FireExtinguisher_Installation</ids:propertySet>
        <ids:name>MountingHeight_m</ids:name>
        <ids:dataType>IFCLENGTHMEASURE</ids:dataType>
      </ids:property>

    </ids:requirements>
  </ids:specification>

  <!-- ===================================================== -->
  <!-- SPEC 6 — MINIMUM PRESENCE PER FLOOR -->
  <!-- ===================================================== -->

  <ids:specification name="Minimum One Per Storey">
    <ids:applicability>
      <ids:entity>
        <ids:name>IfcBuildingStorey</ids:name>
      </ids:entity>
    </ids:applicability>

    <ids:requirements>
      <ids:entity>
        <ids:name>IfcFireSuppressionTerminal</ids:name>
        <ids:minOccurs>1</ids:minOccurs>
      </ids:entity>
    </ids:requirements>
  </ids:specification>

</ids:ids>