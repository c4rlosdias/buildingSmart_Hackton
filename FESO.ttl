@prefix FESO: <https://example.org/FESO#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

#################################################################
# ONTOLOGY METADATA
#################################################################

<https://example.org/FESO>
    a owl:Ontology ;
    rdfs:label "Fire Extinguisher Standard Ontology (FESO)" ;
    dct:description "An executable model representing fire extinguisher standards (inspired by Brazilian NBR 15808 and NBR 12693)" ;
    dct:creator "Hackathon Prototype" ;
    dct:version "1.0" .

#################################################################
# CORE CLASSES
#################################################################

FESO:FireExtinguisher a rdfs:Class ;
    rdfs:label "Fire Extinguisher" .

FESO:ExtinguishingAgent a rdfs:Class .
FESO:FireClass a rdfs:Class .
FESO:RiskClass a rdfs:Class .
FESO:BuildingStorey a rdfs:Class .

#################################################################
# ENUM INSTANCES
#################################################################

# Agents
FESO:Water a FESO:ExtinguishingAgent .
FESO:DryChemicalABC a FESO:ExtinguishingAgent .
FESO:DryChemicalBC a FESO:ExtinguishingAgent .
FESO:CO2 a FESO:ExtinguishingAgent .
FESO:Foam a FESO:ExtinguishingAgent .

# Fire classes
FESO:ClassA a FESO:FireClass .
FESO:ClassB a FESO:FireClass .
FESO:ClassC a FESO:FireClass .

# Risk levels
FESO:LightRisk a FESO:RiskClass .
FESO:ModerateRisk a FESO:RiskClass .
FESO:HighRisk a FESO:RiskClass .

#################################################################
# PROPERTIES
#################################################################

FESO:hasAgent a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range FESO:ExtinguishingAgent .

FESO:hasCapacityRating a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range xsd:string ;
    rdfs:comment "Example: 2A:20B:C" .

FESO:hasAgentMassKg a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range xsd:decimal .

FESO:isCertified a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range xsd:boolean .

FESO:manufactureDate a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range xsd:date .

FESO:installedIn a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range FESO:BuildingStorey .

FESO:coversAreaM2 a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range xsd:decimal .

FESO:maxTravelDistanceM a rdf:Property ;
    rdfs:domain FESO:FireExtinguisher ;
    rdfs:range xsd:decimal .

#################################################################
# RULE MODEL (EXECUTABLE LAYER)
#################################################################

FESO:Rule a rdfs:Class ;
    rdfs:label "Rule" ;
    rdfs:comment "Executable rule derived from fire safety standards" .

FESO:appliesTo a rdf:Property ;
    rdfs:domain FESO:Rule ;
    rdfs:range rdfs:Class .

FESO:condition a rdf:Property ;
    rdfs:domain FESO:Rule ;
    rdfs:range xsd:string .

FESO:constraint a rdf:Property ;
    rdfs:domain FESO:Rule ;
    rdfs:range xsd:string .

#################################################################
# RULES — FIRE CLASS COMPATIBILITY
#################################################################

FESO:Rule_ABC_AllClasses a FESO:Rule ;
    rdfs:label "ABC covers all fire classes" ;
    FESO:appliesTo FESO:FireExtinguisher ;
    FESO:condition "agent = DryChemicalABC" ;
    FESO:constraint "allowedClasses = A,B,C" .

FESO:Rule_CO2_BC a FESO:Rule ;
    rdfs:label "CO2 covers B and C only" ;
    FESO:appliesTo FESO:FireExtinguisher ;
    FESO:condition "agent = CO2" ;
    FESO:constraint "allowedClasses = B,C" .

FESO:Rule_Water_NoC a FESO:Rule ;
    rdfs:label "Water cannot be used on electrical fires" ;
    FESO:appliesTo FESO:FireExtinguisher ;
    FESO:condition "agent = Water" ;
    FESO:constraint "forbiddenClass = C" .

#################################################################
# RULES — COVERAGE (AREA PER UNIT)
#################################################################

FESO:Rule_LightRiskCoverage a FESO:Rule ;
    rdfs:label "Coverage for light risk" ;
    FESO:condition "risk = LightRisk" ;
    FESO:constraint "maxAreaPerUnit = 500" .

FESO:Rule_ModerateRiskCoverage a FESO:Rule ;
    rdfs:label "Coverage for moderate risk" ;
    FESO:condition "risk = ModerateRisk" ;
    FESO:constraint "maxAreaPerUnit = 250" .

FESO:Rule_HighRiskCoverage a FESO:Rule ;
    rdfs:label "Coverage for high risk" ;
    FESO:condition "risk = HighRisk" ;
    FESO:constraint "maxAreaPerUnit = 150" .

#################################################################
# RULES — MAX TRAVEL DISTANCE
#################################################################

FESO:Rule_MaxDistanceLight a FESO:Rule ;
    rdfs:label "Max distance for light/moderate risk" ;
    FESO:condition "risk = LightRisk OR ModerateRisk" ;
    FESO:constraint "maxDistance = 20" .

FESO:Rule_MaxDistanceHigh a FESO:Rule ;
    rdfs:label "Max distance for high risk" ;
    FESO:condition "risk = HighRisk" ;
    FESO:constraint "maxDistance = 15" .

#################################################################
# RULES — CERTIFICATION
#################################################################

FESO:Rule_CertificationMandatory a FESO:Rule ;
    rdfs:label "Extinguisher must be certified" ;
    FESO:appliesTo FESO:FireExtinguisher ;
    FESO:constraint "isCertified = true" .

#################################################################
# RULES — MAINTENANCE
#################################################################

FESO:Rule_HydrostaticTest a FESO:Rule ;
    rdfs:label "Hydrostatic test every 5 years" ;
    FESO:appliesTo FESO:FireExtinguisher ;
    FESO:constraint "hydrostaticTestIntervalYears = 5" .