<?xml version="1.0" encoding="UTF-8"?>
<idcs xmlns="http://fela.org/IDCS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://fela.org/IDCS idcs.xsd">
  <info>
    <title>ABNT NBR 15808 – Extintores de Incêndio Portáteis (compilado)</title>
    <description>Requisitos normativos estruturados a partir do documento nbr15808-extintores.md, mapeados para IDCS conforme FELA.</description>
    <version>1.0.0</version>
  </info>

<constraints>
  <constraint name="NBR15808-4-PR-ge-5xPNC-direta-nao-soldada">
    <annotation>
      <normativeText>Pressurização direta, juntas não soldadas: PR ≥ 5 × PNC e ≥ 5 MPa</normativeText>
    </annotation>
    <appliesTo>
      <entity>IfcFireSuppressionTerminal</entity>
    </appliesTo>
    <condition>
      <and>
        <equals propertySet="Pset_FireExtinguisher_Mechanical" property="PressurisationMode" value="direta"/>
        <equals propertySet="Pset_FireExtinguisher_Mechanical" property="JointType" value="não soldadas"/>
      </and>
    </condition>
    <expression>
      <greaterOrEqual>
        <propertyRef propertySet="Pset_FireExtinguisher_Mechanical" property="BurstPressure"/>
        <multiply>
          <literal>5</literal>
          <propertyRef propertySet="Pset_FireExtinguisher_Mechanical" property="NominalChargingPressure"/>
        </multiply>
      </greaterOrEqual>
    </expression>
  </constraint>

  <constraint name="NBR15808-4-PR-ge-5MPa-direta-nao-soldada">
    <annotation>
