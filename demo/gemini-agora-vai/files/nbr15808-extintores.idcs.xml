  <constraint name="NBR12693-7-4-altura-manipulo-ge-0.10m">
    <annotation>
      <normativeText>Altura do manípulo: Entre 10 cm e 1,60 m do piso acabado</normativeText>
    </annotation>
    <appliesTo>
      <entity>IfcFireSuppressionTerminal</entity>
    </appliesTo>
    <expression>
      <greaterOrEqual>
        <propertyRef propertySet="Pset_FireExtinguisher_Installation" property="MountingHeight"/>
