  <constraint name="NBR15808-3-INMETRO-certificado-igual-true-ge">
    <annotation>
      <normativeText>A certificação INMETRO é obrigatória para todos os extintores comercializados no Brasil.</normativeText>
    </annotation>
    <appliesTo>
      <entity>IfcFireSuppressionTerminal</entity>
    </appliesTo>
    <expression>
